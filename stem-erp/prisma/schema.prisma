datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum DeliveryGroup {
  ENGINEERING_CAD     // Setor: Engenharia & CAD
  MANUFACTURING_CNC   // Setor: Manufatura & CNC
  PIT_DISPLAY         // Setor: Pit Display & Estande
  MARKETING_SPONSOR   // Setor: Marketing & Patrocínio
  PROJECT_MANAGEMENT  // Setor: Gestão do Projeto
  SOCIAL_PROJECT      // Setor: Projeto Social
}

enum AcquisitionStrategy {
  DIRECT_PURCHASE     // Compra Direta
  FINANCIAL_SPONSOR   // Patrocínio Financeiro
  BARTER_PARTNERSHIP  // Permuta / Parceria Técnica
  OWN_FUNDS_RAFFLE    // Recursos Próprios / Rifa / Evento
}

enum TransactionType {
  ORIGIN              // Origem (Entrada / Ganho / Patrocínio)
  APPLICATION         // Aplicação (Saída / Despesa)
}

enum TrackingMethod {
  NFE                 // Nota Fiscal Eletrônica
  RECEIPT             // Recibo Simples
  SPONSOR_CONTRACT    // Contrato de Patrocínio
  BANK_PIX_STATEMENT  // Comprovante PIX / Extrato Bancário
}

enum SponsorTier {
  BRONZE   // Cota Bronze
  SILVER   // Cota Prata
  GOLD     // Cota Ouro
  DIAMOND  // Cota Diamante
}

enum ReturnActionCategory {
  CAR_UNIFORM_BRANDING // Logo no Carro / Uniforme / Equipamentos
  SOCIAL_MEDIA         // Publicação / Reels / Stories em Redes Sociais
  PIT_DISPLAY_EVENT    // Exposição em Pit Display / Estande / Eventos
  PRESS_PORTFOLIO      // Imprensa / Portfólio Oficial / Apresentações
  SOCIAL_WORKSHOP      // Ação / Oficina em Projeto Social
  OTHER_ACTIVATION     // Outras Ativações de Marca
}

enum UserRole {
  SUPER_ADMIN         // Administrador Global da Plataforma (Cria Equipes e Usuários)
  FINANCE_MANAGER     // Diretor Financeiro da Equipe
  TEAM_LEAD           // Líder de Setor / Integrante da Equipe
  AUDITOR             // Juiz / Auditor da Equipe (Somente Leitura)
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  SESSION_REVOKED
  USER_CREATED
  USER_ROLE_UPDATED
  TEAM_CREATED
}

// 0. Equipes da Competição (Ex: Equipe Gênesis, Equipe Alpha)
model Team {
  id              String           @id @default(cuid())
  name            String           @unique // Ex: Equipe Gênesis, Equipe Alpha
  slug            String           @unique // Ex: equipe-genesis, equipe-alpha
  schoolOrOrg     String?          // Ex: SENAI / Escuderia Gênesis
  senderEmail     String           @default("genesisteamracing@gmail.com") // E-mail oficial de envio de relatórios
  smtpAppPassword String?          // Senha de App do Google (16 caracteres) para disparo SMTP real
  season          String?          // Temporada: "2025/2026"
  seasonStartDate DateTime?        // Início da temporada (gera os meses do fluxo de caixa)
  seasonEndDate   DateTime?        // Fim da temporada
  isActive        Boolean          @default(true)
  users           User[]
  categories      Category[]
  budgetResources BudgetResource[]
  transactions    Transaction[]
  sponsors        Sponsor[]
  returnActions   ReturnAction[]
  stakeholders    Stakeholder[]
  communicationPlans CommunicationPlan[]
  communicationLogs  CommunicationLog[]
  wbsNodes           WbsNode[]
  tasks              Task[]
  riskPaths          RiskPath[]
  riskItems          RiskItem[]
  riskReviews        RiskReview[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// 1. Categorias de Custo/Receita (Isoladas por Equipe, organizadas por Setor)
model Category {
  id            String           @id @default(cuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String           // Ex: Matéria-Prima, Usinagem, Uniformes, Aporte Ouro
  deliveryGroup DeliveryGroup    // Setor interno da equipe
  budgetItems   BudgetResource[]
  transactions  Transaction[]
  createdAt     DateTime         @default(now())

  @@unique([teamId, name])
}

// 2. Planejamento de Recursos e Orçamento (PREVISTO — Isolado por Equipe)
model BudgetResource {
  id                  String              @id @default(cuid())
  teamId              String
  team                Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  code                String              // Ex: ORC-001 (sequencial por Equipe)
  deliveryGroup       DeliveryGroup       // Setor interno da equipe
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id])
  resourceName        String              // Ex: Blocos de Poliuretano Oficial
  acquisitionStrategy AcquisitionStrategy
  allocatedTo         String              // Responsável (Ex: Líder de Manufatura)
  plannedMonth        Int                 // 1 a 6
  utilizationForecast Int                 // 0 a 100 (%)
  plannedAmountCents  Int                 // Valor previsto em centavos
  transactions        Transaction[]       // Transações reais atreladas a este item planejado
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([teamId, code])
  @@index([teamId, deliveryGroup, plannedMonth])
}

// 3. Lançamentos Financeiros e Fluxo de Caixa (REALIZADO — Isolado por Equipe)
model Transaction {
  id               String          @id @default(cuid())
  teamId           String
  team             Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date             DateTime        // Data real do fato gerador
  referenceMonth   Int             // Mês na linha do tempo do projeto (1 a 6)
  type             TransactionType // ORIGIN (Ganho) ou APPLICATION (Despesa)
  deliveryGroup    DeliveryGroup   // Setor interno da equipe
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  budgetResourceId String?         // Opcional: vincula o gasto diretamente a um item do orçamento
  budgetResource   BudgetResource? @relation(fields: [budgetResourceId], references: [id])
  description      String
  trackingMethod   TrackingMethod
  documentRef      String?         // Número da NF-e, código da transação ou link do comprovante
  amountCents      Int             // Valor realizado em centavos
  sponsorId        String?         // Empresa patrocinadora (obrigatório se contrato de patrocínio)
  sponsor          Sponsor?        @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([teamId, referenceMonth, type])
  @@index([teamId, deliveryGroup, referenceMonth])
  @@index([teamId, sponsorId])
}

// 4. Usuários / Integrantes da Plataforma
model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  passwordHash        String
  role                UserRole        @default(TEAM_LEAD)
  teamId              String?         // Equipe à qual pertence (Ex: Equipe Gênesis ou Equipe Alpha)
  team                Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  deliveryGroup       DeliveryGroup?  // Setor/Área de atuação dentro da equipe
  jobTitle            String?         // Ex: Líder de Manufatura CNC
  isActive            Boolean         @default(true)

  // Permissões granulares de acesso por módulo (SIM = true / NÃO = false)
  canAccessFinance       Boolean         @default(true)
  canAccessRoi           Boolean         @default(true)
  canAccessCommunication Boolean         @default(true)
  canAccessTeam          Boolean         @default(false)
  canAccessDocuments     Boolean         @default(true)
  canAccessTasks         Boolean         @default(false)
  canAccessRisks         Boolean         @default(true)

  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?       // Bloqueio automático anti-força bruta
  lastLoginAt         DateTime?
  createdById         String?
  sessions            Session[]
  auditLogs           AuthAuditLog[]
  wbsNodes            WbsNode[]
  authoredTasks       Task[]
  taskAssignments     TaskAssignment[]
  ownedRisks          RiskItem[]      @relation("RiskOwner")
  createdRisks        RiskItem[]      @relation("RiskCreator")
  riskReviews         RiskReview[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([teamId, role])
}

// 5. Sessões Ativas (Controle Stateful + Revogação Remota via Cookie httpOnly)
model Session {
  id           String    @id @default(cuid()) // Usado como `jti` no JWT
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

// 6. Trilha de Auditoria de Segurança (Detecção de Tentativas de Invasão)
model AuthAuditLog {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAttempt String
  event        AuthEventType
  ipAddress    String?
  userAgent    String?
  details      String?
  createdAt    DateTime      @default(now())

  @@index([emailAttempt, createdAt])
  @@index([event, createdAt])
}

// 7. Empresas Patrocinadoras (Isoladas por Equipe, Cotas Bronze/Prata/Ouro/Diamante)
model Sponsor {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String         // Ex: Bosch, SENAI, Haas Automation
  tier          SponsorTier    // BRONZE, SILVER, GOLD, DIAMOND
  contactName   String?        // Nome do ponto focal / contato na empresa
  notes         String?        // Contrapartidas e observações
  transactions  Transaction[]  // Lançamentos vinculados (investimento da empresa)
  returnActions ReturnAction[] // Ações executadas pela equipe para entrega de retorno
  stakeholders  Stakeholder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([teamId, name])
  @@index([teamId, tier])
}

// 8. Ações de Retorno da Equipe aos Patrocinadores
model ReturnAction {
  id          String               @id @default(cuid())
  teamId      String
  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sponsorId   String
  sponsor     Sponsor              @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  date        DateTime             // Data da realização da ação
  title       String               // Ex: Exposição de Logo no Bico do Carro F1
  category    ReturnActionCategory // Categoria da entrega de retorno
  reachCount  Int?                 // Alcance estimado / público / impressões
  returnCents Int                  // Valoração do retorno entregue em centavos
  description String?              // Detalhamento auditável / links de evidência
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([teamId, sponsorId, date])
}

// ==========================================
// MÓDULO: COMUNICAÇÃO & ENGAJAMENTO DE STAKEHOLDERS
// ==========================================

enum StakeholderGroup {
  SPONSORS              // Patrocinadores e Parceiros Corporativos
  SCHOOL_LEADERSHIP     // Direção Escolar, Coordenação e Professores
  PARENTS_GUARDIANS     // Pais e Responsáveis dos Integrantes
  TECHNICAL_MENTORS     // Mentores Técnicos, Ex-Alunos e Especialistas
  COMMUNITY_FANS        // Comunidade, Alunos e Apoiadores
  COMPETITION_OFFICIALS // Organizadores da Competição e Jurados
}

enum StakeholderPower {
  LOW
  HIGH
}

enum StakeholderInterest {
  LOW
  HIGH
}

enum EngagementLevel {
  UNAWARE    // Desinformado sobre o projeto
  RESISTANT  // Resistente ou cético
  NEUTRAL    // Neutro / Ciente sem apoio ativo
  SUPPORTIVE // Apoiador ativo
  LEADING    // Líder / Defensor engajado do time
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  MEETING
  REPORT_PDF
}

enum CommunicationFrequency {
  WEEKLY          // Semanal
  BIWEEKLY        // Quinzenal
  MONTHLY         // Mensal
  BIMONTHLY       // Bimestral
  QUARTERLY       // Trimestral
  MILESTONE_EVENT // Pós-Marco / Evento Crítico
}

enum FeedbackSentiment {
  POSITIVE               // Positivo / Elogio
  NEUTRAL                // Neutro / Informativo
  CONSTRUCTIVE_CRITICISM // Crítica Construtiva / Ponto de Atenção
}

// 9. Partes Interessadas / Stakeholders
model Stakeholder {
  id                   String                 @id @default(cuid())
  teamId               String
  team                 Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sponsorId            String?                // Vínculo opcional se for patrocinador já cadastrado
  sponsor              Sponsor?               @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  parentStakeholderId  String?                // Vínculo hierárquico opcional dentro do mesmo Parceiro
  parent               Stakeholder?           @relation("StakeholderHierarchy", fields: [parentStakeholderId], references: [id], onDelete: SetNull)
  children             Stakeholder[]          @relation("StakeholderHierarchy")
  name                 String                 // Nome da pessoa ou entidade
  organization         String?                // Ex: Colégio Alfa, Empresa Bosch, SESI
  roleOrJobTitle       String?                // Ex: Diretor Pedagógico, Gerente de Marketing
  group                StakeholderGroup       // Grupo de Stakeholder
  email                String?
  phone                String?                // WhatsApp no formato (DD) 9XXXX-XXXX
  power                StakeholderPower       @default(LOW)
  interest             StakeholderInterest    @default(LOW)
  currentEngagement    EngagementLevel        @default(NEUTRAL)
  targetEngagement     EngagementLevel        @default(SUPPORTIVE)
  preferredChannel     CommunicationChannel   @default(WHATSAPP)
  preferredFrequency   CommunicationFrequency @default(MONTHLY)
  notes                String?                // Abordagem personalizada / requisitos especiais
  plans                CommunicationPlan[]
  communications       CommunicationLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([teamId, group])
  @@index([teamId, power, interest])
  @@index([teamId, organization])
  @@index([teamId, parentStakeholderId])
}

// 10. Planos / Régua de Comunicação por Stakeholder
model CommunicationPlan {
  id                    String                 @id @default(cuid())
  teamId                String
  team                  Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stakeholderId         String
  stakeholder           Stakeholder            @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  title                 String                 // Ex: Relatório Quinzenal de Metas e Finanças
  channel               CommunicationChannel   // WHATSAPP, EMAIL, etc.
  frequency             CommunicationFrequency // WEEKLY, BIWEEKLY, MONTHLY...
  customApproach        String?                // Tom de voz e abordagem personalizada
  keyInformation        String?                // Conteúdos obrigatórios (ROI, Caixa, Protótipo)
  responsibleMemberId   String?                // Integrante da equipe responsável
  responsibleMemberName String?
  isActive              Boolean                @default(true)
  lastDispatchedAt      DateTime?
  nextDispatchDate      DateTime?
  communications        CommunicationLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([teamId, stakeholderId])
}

// 11. Registro / Log de Comunicações Realizadas
model CommunicationLog {
  id                 String                  @id @default(cuid())
  teamId             String
  team               Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stakeholderId      String
  stakeholder        Stakeholder             @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  planId             String?
  plan               CommunicationPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  subject            String                  // Assunto / Título do envio
  channel            CommunicationChannel
  sentAt             DateTime                @default(now())
  dispatchedByName   String                  // Nome do integrante que realizou o disparo
  contentSummary     String                  // Conteúdo da mensagem enviada
  reportTypeIncluded String?                 // "FINANCIAL", "ROI", "COMBINED" ou "CUSTOM"
  evidenceLink       String?                 // Link do anexo / screenshot da conversa / ata
  feedbacks          CommunicationFeedback[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([teamId, stakeholderId, sentAt])
}

// 12. Ciclos de Feedback & Melhoria Contínua
model CommunicationFeedback {
  id                          String            @id @default(cuid())
  communicationLogId          String
  communicationLog            CommunicationLog  @relation(fields: [communicationLogId], references: [id], onDelete: Cascade)
  receivedAt                  DateTime          @default(now())
  sentiment                   FeedbackSentiment
  stakeholderResponse         String            // Resumo do retorno do stakeholder
  continuousImprovementAction String?           // Ação de melhoria implementada pelo time com base no retorno
  isAddressed                 Boolean           @default(false)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@index([communicationLogId])
}

// ==========================================
// MÓDULO: DOCUMENTOS & WBS (ESTRUTURA ANALÍTICA DO PROJETO)
// ==========================================

enum WbsNodeStatus {
  PLANNED      // Planejado no escopo inicial
  IN_PROGRESS  // Em construção / execução
  COMPLETED    // Entregável finalizado
  AUDITED      // Validado perante banca de escrutínio / PM
}

// 13. Entregáveis e Pacotes de Trabalho da WBS / EAP (Isolados por Equipe)
model WbsNode {
  id                 String         @id @default(cuid())
  teamId             String
  team               Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             WbsNode?       @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           WbsNode[]      @relation("WbsHierarchy")
  
  code               String         // Código EAP (ex: "1.0", "1.2", "1.2.3")
  title              String         // Nome do Entregável
  description        String?        // Descrição do escopo específico ("o que precisa ser construído")
  discipline         DeliveryGroup  // Setor: Engenharia, Manufatura, Pit Display, Marketing, Gestão, Social
  
  ownerId            String?
  owner              User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName          String?        // Nome em cache do responsável para renderização rápida
  
  status             WbsNodeStatus  @default(PLANNED)
  estimatedCostCents Int            @default(0) // Custo direto de fabricação em centavos (folhas)
  estimatedHours     Int            @default(0) // Esforço direto estimado em horas (folhas)
  
  sortOrder          Int            @default(0) // Ordem de apresentação entre nós irmãos
  depth              Int            @default(1) // 1 = Raiz/Projeto, 2 = Subsistema, 3 = Pacote de Trabalho
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([teamId, code])
  @@index([teamId, parentId])
  @@index([teamId, discipline])
  @@index([teamId, depth])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskAssignmentRole {
  R
  C
  I
}

model Task {
  id            String           @id @default(cuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveryGroup DeliveryGroup
  title         String
  description   String?
  startDate     DateTime         @db.Date
  endDate       DateTime         @db.Date
  status        TaskStatus       @default(TODO)
  completedAt   DateTime?
  sortOrder     Int              @default(0)
  cancelledAt   DateTime?
  creatorKey    String
  creatorName   String
  creatorUserId String?
  creator       User?            @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  revision      Int              @default(0)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignments   TaskAssignment[]
  outgoing      TaskDependency[] @relation("TaskPredecessor")
  incoming      TaskDependency[] @relation("TaskSuccessor")
  riskSteps     RiskPathStep[]

  @@unique([teamId, id])
  @@index([teamId, deliveryGroup])
  @@index([teamId, sortOrder])
}

model TaskAssignment {
  teamId     String
  taskId     String
  task       Task               @relation(fields: [teamId, taskId], references: [teamId, id], onDelete: Cascade)
  memberKey  String
  memberName String
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       TaskAssignmentRole

  @@id([teamId, taskId, memberKey, role])
  @@index([userId])
}

model TaskDependency {
  teamId        String
  predecessorId String
  successorId   String
  predecessor   Task     @relation("TaskPredecessor", fields: [teamId, predecessorId], references: [teamId, id], onDelete: Cascade)
  successor     Task     @relation("TaskSuccessor", fields: [teamId, successorId], references: [teamId, id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([teamId, predecessorId, successorId])
  @@index([teamId, successorId])
}

model RiskPath {
  id        String         @id @default(cuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  reason    String
  revision  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  steps     RiskPathStep[]

  @@unique([teamId, id])
}

model RiskPathStep {
  teamId   String
  pathId   String
  position Int
  taskId   String
  path     RiskPath @relation(fields: [teamId, pathId], references: [teamId, id], onDelete: Cascade)
  task     Task     @relation(fields: [teamId, taskId], references: [teamId, id], onDelete: Cascade)

  @@id([teamId, pathId, position])
  @@unique([teamId, pathId, taskId])
}

// ============================================================================
// MÓDULO: GESTÃO DE RISCOS & OPORTUNIDADES
// ============================================================================

enum RiskEntryType {
  RISK
  OPPORTUNITY
}

enum RiskProbability {
  QUASE_CERTO
  PROVAVEL
  POSSIVEL
  IMPROVAVEL
  RARA
  NONE
}

enum RiskConsequence {
  CATASTROFICA
  GRANDE
  MODERADA
  PEQUENA
  DESPREZIVEL
  NONE
}

enum RiskLifecycleStatus {
  IDENTIFIED
  MONITORING
  MITIGATED
  OCCURRED
  CLOSED
}

enum RiskPriorityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNASSESSED
}

model RiskItem {
  id                String              @id @default(cuid())
  teamId            String
  team              Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season            String              @default("2025/2026")
  entryType         RiskEntryType       @default(RISK)
  title             String
  description       String?
  sector            DeliveryGroup
  probability       RiskProbability     @default(NONE)
  consequence       RiskConsequence     @default(NONE)
  priorityScore     Int                 @default(0)
  priorityLevel     RiskPriorityLevel   @default(UNASSESSED)
  proactiveStrategy String?
  contingencyPlan   String?
  observations      String?
  evidenceNotes     String?
  evidenceUrl       String?
  status            RiskLifecycleStatus @default(IDENTIFIED)
  ownerName         String?
  ownerUserId       String?
  owner             User?               @relation("RiskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdByUserId   String?
  createdBy         User?               @relation("RiskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviews           RiskReview[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([teamId, season])
  @@index([teamId, sector])
  @@index([teamId, priorityScore])
}

model RiskReview {
  id                  String              @id @default(cuid())
  riskItemId          String
  riskItem            RiskItem            @relation(fields: [riskItemId], references: [id], onDelete: Cascade)
  teamId              String
  team                Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  previousProbability RiskProbability
  newProbability      RiskProbability
  previousConsequence RiskConsequence
  newConsequence      RiskConsequence
  previousStatus      RiskLifecycleStatus
  newStatus           RiskLifecycleStatus
  notes               String
  evidenceNotes       String?
  evidenceUrl         String?
  reviewerName        String
  reviewerUserId      String?
  reviewer            User?               @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime            @default(now())

  @@index([riskItemId, reviewedAt])
  @@index([teamId])
}
